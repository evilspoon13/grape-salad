# Base URL of the FastAPI backend (no trailing slash). The api.ts wrapper appends /api/...
VITE_API_BASE_URL=http://localhost:8000

# Set to "true" to run entirely against the in-memory mock backend (src/mocks) with no
# network/backend required — great for building UI before endpoints exist. Leave unset/false
# to hit the real backend at VITE_API_BASE_URL.
VITE_USE_MOCKS=false
