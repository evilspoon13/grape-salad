# Supabase Postgres — use the TRANSACTION-MODE POOLER connection string (not the direct/session one).
# Format: postgresql+asyncpg://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase project — used only for Storage signed uploads (the one place we use supabase-py)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Anthropic — server-side key for digest generation
ANTHROPIC_API_KEY=

# CORS — the frontend origin (Vite dev server by default)
FRONTEND_ORIGIN=http://localhost:5173
